# HTTP server
PORT=8080
LOG_LEVEL=info

# Log shipping (OpenTelemetry -> collector stack in ../collector; `make up` there first).
# Leave unset for stderr-only logging (default).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# APP_ENV=dev
# The containerized ocr worker reaches the host-published collector port via the
# host gateway (separate var so the container doesn't inherit localhost):
# OCR_OTLP_ENDPOINT=http://host.docker.internal:4317

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://mortgage:mortgage@localhost:5432/mortgage?sslmode=disable

# Object storage
GCS_BUCKET=matriculas
# Point the GCS client at fake-gcs-server in local dev; unset in production.
STORAGE_EMULATOR_HOST=localhost:4443
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json   # production only

# Upload limits
MAX_UPLOAD_MB=25
MAX_PAGES=100

# OCR worker (cmd/ocr; the compose `ocr` service in local dev)
OCR_SERVICE_URL=http://localhost:9090
OCR_DISPATCH_TIMEOUT=10s

# OCR worker settings (cmd/ocr reads these, not the API)
# Engine: stub (offline fixture), glm (OpenAI-compatible GLM-OCR endpoint:
# vLLM, SGLang or Ollama), glm-maas (Zhipu cloud layout_parsing API).
OCR_ENGINE=stub
# OCR_PAGE_CONCURRENCY=2
# OCR_JOB_TIMEOUT=8m
# OCR_MODEL_TIMEOUT=120s
# Stub only:
# DELAY=2s
# FAIL_RATE=0
# glm engine:
# GLM_BASE_URL=http://localhost:11434
# GLM_MODEL=glm-ocr
# GLM_API_KEY=
# glm-maas engine (key from https://open.bigmodel.cn):
# ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# LLM extraction
LLM_PROVIDER=anthropic   # anthropic | ollama | stub
LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...
# For LLM_PROVIDER=ollama: set LLM_MODEL to any model pulled locally
# (`ollama list`) and optionally override the server URL:
# LLM_BASE_URL=http://localhost:11434

# Extraction poller
POLL_INTERVAL=5s
STUCK_TIMEOUT=10m
MAX_EXTRACTION_ATTEMPTS=3
